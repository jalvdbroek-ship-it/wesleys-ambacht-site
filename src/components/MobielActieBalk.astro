---
/**
 * Vaste actiebalk onderaan het scherm, alleen op een telefoon.
 * Bellen en een offerte aanvragen blijven daarmee altijd binnen
 * bereik, zonder dat het de pagina wegdrukt.
 */
import { site } from '../data/site';
---

<div class="actiebalk" aria-label="Snel contact">
  <a href={`tel:${site.phoneHref}`} class="actiebalk-knop">
    <svg width="17" height="17" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path
        d="M5.7 2.9h2.1l1.3 3.3-1.5 1.1a10.2 10.2 0 0 0 5.1 5.1l1.1-1.5 3.3 1.3v2.1c0 .7-.6 1.3-1.3 1.3C8.6 15.7 4.3 11.4 4.3 3.2c0-.7.6-1.3 1.4-1.3Z"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"
      />
    </svg>
    Bellen
  </a>
  <a href="/contact" class="actiebalk-knop actiebalk-hoofd">Offerte aanvragen</a>
</div>

<style>
  .actiebalk {
    display: none;
  }

  @media (max-width: 767px) {
    .actiebalk {
      position: fixed;
      z-index: 60;
      inset: auto 0 0 0;
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: 0.5rem;
      padding: 0.625rem 1rem calc(0.625rem + env(safe-area-inset-bottom));
      background-color: rgb(255 255 255 / 0.96);
      backdrop-filter: blur(12px);
      border-top: 1px solid var(--color-lijn);
    }

    .actiebalk-knop {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.4375rem;
      min-height: 2.875rem;
      padding-inline: 1rem;
      border: 1px solid var(--color-lijn-invoer);
      border-radius: var(--radius-knop);
      font-size: 0.9375rem;
      font-weight: 600;
      color: var(--color-haven);
      text-decoration: none;
    }

    .actiebalk-hoofd {
      background-color: var(--color-signaal);
      border-color: var(--color-signaal);
      color: var(--color-wit);
    }

    .actiebalk-hoofd:hover {
      background-color: var(--color-signaal-donker);
      border-color: var(--color-signaal-donker);
    }
  }
</style>
