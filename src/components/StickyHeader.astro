---
import { navigation, site, openingstijdenCompact } from '../data/site';
import { withBase, withoutBase } from '../lib/urls';

const pad = withoutBase(Astro.url.pathname);
const isActief = (href: string) =>
  href === '/' ? pad === '/' : pad === href || pad.startsWith(`${href}/`);
---

<header class="kop" id="kop">
  <div class="rail kop-rij">
    <a href={withBase('/')} class="merk" aria-label="Wesley's Ambacht, naar de homepage">
      <img src={withBase('/images/merk.png')} alt="" width="1013" height="822" class="merk-logo" />
    </a>

    <nav class="menu" aria-label="Hoofdmenu">
      {
        navigation.map((item) => (
          <a
            href={withBase(item.href)}
            class={`menu-link${isActief(item.href) ? ' is-actief' : ''}`}
            aria-current={isActief(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="kop-rechts">
      <span class="openingstijd">{openingstijdenCompact}</span>
      <a href={`tel:${site.phoneHref}`} class="bel-cirkel" aria-label={`Bel ${site.phone}`}>
        <svg width="19" height="19" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path
            d="M5.7 2.9h2.1l1.3 3.3-1.5 1.1a10.2 10.2 0 0 0 5.1 5.1l1.1-1.5 3.3 1.3v2.1c0 .7-.6 1.3-1.3 1.3C8.6 15.7 4.3 11.4 4.3 3.2c0-.7.6-1.3 1.4-1.3Z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"
          />
        </svg>
      </a>
      <button
        type="button"
        class="menu-knop"
        aria-expanded="false"
        aria-controls="mobiel-menu"
        aria-label="Menu openen"
      >
        <span class="menu-streep"></span>
        <span class="menu-streep"></span>
        <span class="menu-streep"></span>
      </button>
    </div>
  </div>

  <nav id="mobiel-menu" class="mobiel-menu" aria-label="Mobiel menu" hidden>
    <div class="rail mobiel-menu-inhoud">
      {
        navigation.map((item) => (
          <a href={withBase(item.href)} class={`mobiel-link${isActief(item.href) ? ' is-actief' : ''}`}>
            {item.label}
          </a>
        ))
      }
      <a href={`tel:${site.phoneHref}`} class="knop knop-haven mobiel-knop">Bel {site.phone}</a>
    </div>
  </nav>
</header>

<script>
  const knop = document.querySelector<HTMLButtonElement>('.menu-knop');
  const menu = document.getElementById('mobiel-menu');

  const setMenu = (open: boolean) => {
    knop?.setAttribute('aria-expanded', String(open));
    knop?.setAttribute('aria-label', open ? 'Menu sluiten' : 'Menu openen');
    if (menu) menu.hidden = !open;
  };

  knop?.addEventListener('click', () => {
    setMenu(knop.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (knop?.getAttribute('aria-expanded') !== 'true') return;
    setMenu(false);
    knop.focus();
  });
</script>

<style>
  .kop {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: rgb(255 255 255 / 0.94);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-lijn);
  }

  .kop-rij {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 5rem;
    transition: min-height 240ms var(--easing);
  }

  /* Bij het scrollen wordt de kop kleiner: er blijft meer van de
     pagina over. */
  .kop.is-compact .kop-rij {
    min-height: 4.25rem;
  }

  .kop.is-compact .merk-logo {
    width: 5.25rem;
  }

  .merk-logo {
    width: 6rem;
    height: auto;
    display: block;
    transition: width 240ms var(--easing);
  }

  .merk {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .menu {
    display: none;
    align-items: center;
    gap: 1.5rem;
  }

  .menu-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
    padding-block: 0.375rem;
    border-bottom: 2px solid transparent;
    transition:
      color var(--duur) var(--easing),
      border-color var(--duur) var(--easing);
  }

  .menu-link:hover {
    color: var(--color-signaal);
  }

  .menu-link.is-actief {
    color: var(--color-haven);
    font-weight: 600;
    border-bottom-color: var(--color-signaal);
  }

  .kop-rechts {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .openingstijd {
    display: none;
    font-size: 0.8125rem;
    color: var(--color-ink-mist);
    white-space: nowrap;
  }

  .bel-cirkel {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    border-radius: 50%;
    background-color: var(--color-signaal);
    color: var(--color-wit);
    text-decoration: none;
    transition: background-color var(--duur) var(--easing);
  }

  .bel-cirkel:hover {
    background-color: var(--color-signaal-donker);
  }

  .menu-knop {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.875rem;
    height: 2.875rem;
    padding: 0 0.625rem;
    background-color: transparent;
    border: 1px solid var(--color-lijn-invoer);
    border-radius: var(--radius-invoer);
    cursor: pointer;
  }

  .menu-streep {
    display: block;
    height: 1.5px;
    width: 100%;
    background-color: var(--color-haven);
  }

  .mobiel-menu {
    border-top: 1px solid var(--color-lijn);
    background-color: var(--color-wit);
  }

  .mobiel-menu-inhoud {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-block: 1rem 1.5rem;
  }

  .mobiel-link {
    display: block;
    padding: 0.75rem 0.5rem;
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--color-haven);
    text-decoration: none;
    border-radius: var(--radius-invoer);
  }

  .mobiel-link.is-actief {
    color: var(--color-signaal);
    font-weight: 600;
  }

  .mobiel-knop {
    margin-top: 0.75rem;
  }

  @media (min-width: 900px) {
    .menu {
      display: flex;
    }

    .menu-knop,
    .mobiel-menu {
      display: none;
    }
  }

  @media (min-width: 1120px) {
    .openingstijd {
      display: inline;
    }
  }
</style>
