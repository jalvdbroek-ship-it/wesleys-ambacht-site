---
/**
 * Een brede fotoband over de hele breedte, met een korte zin erop.
 * Zet de pagina op zijn hoogte en laat de ogen even rust.
 */
import { withBase } from '../lib/urls';
interface Props {
  afbeelding: string;
  alt: string;
  zin: string;
  onderschrift?: string;
  donker?: boolean;
}

const { afbeelding, alt, zin, onderschrift, donker = true } = Astro.props;
---

<figure class={`havenband${donker ? ' is-donker' : ''}`}>
  <img src={withBase(afbeelding)} alt={alt} loading="lazy" decoding="async" />
  <div class="havenband-scherm" aria-hidden="true"></div>
  <figcaption class="rail havenband-tekst">
    <p class="havenband-zin">{zin}</p>
    {onderschrift ? <p class="havenband-onder">{onderschrift}</p> : null}
  </figcaption>
</figure>

<style>
  .havenband {
    position: relative;
    margin: 0;
    isolation: isolate;
    overflow: hidden;
  }

  .havenband img {
    width: 100%;
    height: clamp(15rem, 42vw, 27rem);
    object-fit: cover;
    display: block;
  }

  .havenband-scherm {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(10 32 54 / 0.15) 0%,
      rgb(10 32 54 / 0.62) 100%
    );
  }

  .havenband-tekst {
    position: absolute;
    inset: auto 0 0 0;
    padding-block: 2.5rem 2rem;
    color: var(--color-wit);
  }

  .havenband-zin {
    font-size: clamp(1.375rem, 2.6vw, 2rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    max-width: 26ch;
    text-wrap: balance;
  }

  .havenband-onder {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    color: rgb(255 255 255 / 0.86);
    max-width: 46ch;
  }

  .is-niet-donker .havenband-scherm {
    background: linear-gradient(180deg, rgb(10 32 54 / 0.05) 0%, rgb(10 32 54 / 0.4) 100%);
  }
</style>
