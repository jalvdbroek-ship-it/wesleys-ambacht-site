---
import { navigation, site } from '../data/site';

const jaar = new Date().getFullYear();
const openingstijden = site.openingstijden;
---

<footer class="voet">
  <span class="voet-boog" aria-hidden="true"></span>
  <div class="rail voet-inhoud">
    <div class="voet-kolom voet-merk">
      <img src="/images/merk.png" alt="Wesley's Ambacht" width="1013" height="822" class="voet-logo" />
      <p class="voet-tagline">
        Verse vis van de vismijn in Stellendam. Ambachtelijke catering op locatie en
        vergaderen met uitzicht over de buitenhaven.
      </p>
    </div>

    <div class="voet-kolom">
      <h2 class="voet-kop">Pagina's</h2>
      <ul class="voet-lijst">
        {
          navigation.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="voet-kolom">
      <h2 class="voet-kop">Open</h2>
      <ul class="voet-lijst">
        {
          openingstijden.map((rij) => (
            <li>
              <span class="voet-dag">{rij.dag}</span>
              <span class="voet-tijd">{rij.tijd}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="voet-kolom">
      <h2 class="voet-kop">Contact</h2>
      <ul class="voet-lijst">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
        <li>
          <a href={site.maps} target="_blank" rel="noopener">
            {site.address.straat}<br />
            {site.address.postcode} {site.address.plaats}
          </a>
        </li>
        <li>
          <a href={site.instagram} target="_blank" rel="noopener">Instagram</a>
          <a href={site.facebook} target="_blank" rel="noopener">Facebook</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="rail voet-onder">
    <p>&copy; {jaar} Wesley's Ambacht</p>
    <p>Zonder E-nummers. Met verse kruiden uit de eigen tuin.</p>
  </div>
</footer>

<style>
  .voet {
    position: relative;
    overflow: hidden;
    background-color: var(--color-wit);
    border-top: 3px solid var(--color-signaal);
    padding-top: 3.5rem;
  }

  /* De ring van de haven loopt de hoek uit. */
  .voet-boog {
    position: absolute;
    right: -7rem;
    bottom: -9rem;
    width: 22rem;
    height: 22rem;
    border: 2px solid var(--color-haven-mist);
    border-radius: 50%;
    pointer-events: none;
  }

  .voet-inhoud {
    position: relative;
    display: grid;
    gap: 2.5rem;
    padding-block: 0 2.5rem;
  }

  .voet-kolom {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .voet-logo {
    width: 8rem;
    height: auto;
  }

  .voet-tagline {
    font-size: 0.9375rem;
    color: var(--color-ink-mist);
    max-width: 24rem;
    margin-top: 0.25rem;
  }

  .voet-kop {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-haven);
  }

  .voet-lijst {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.9375rem;
  }

  .voet-lijst a {
    color: var(--color-ink-mist);
    text-decoration: none;
    transition: color var(--duur) var(--easing);
  }

  .voet-lijst a:hover {
    color: var(--color-signaal);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .voet-dag {
    display: block;
    color: var(--color-ink);
  }

  .voet-tijd {
    display: block;
    color: var(--color-ink-mist);
    font-size: 0.875rem;
  }

  .voet-onder {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding-block: 1.25rem 2rem;
    border-top: 1px solid var(--color-lijn);
    font-size: 0.8125rem;
    color: var(--color-ink-mist);
  }

  @media (min-width: 640px) {
    .voet-onder {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  @media (min-width: 900px) {
    .voet-inhoud {
      grid-template-columns: 1.3fr 1fr 1fr 1fr;
      gap: 3rem;
    }
  }
</style>
