---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectieKop from '../components/SectieKop.astro';
import CtaBlok from '../components/CtaBlok.astro';
import Menukaart from '../components/Menukaart.astro';
import Faq from '../components/Faq.astro';
import HavenBand from '../components/HavenBand.astro';
import {
  catering,
  vleespakketten,
  buffetten,
  salades,
  borrelplanken,
  broodjes,
  koffie,
  kosten,
  site,
  grillAvond,
} from '../data/site';

const brochures = [
  { href: '/brochures/pdf_Warm_Buffet.pdf', label: 'Buffetten en arrangementen', note: 'Alle buffetten, BBQ-arrangementen en stamppotten' },
  { href: '/brochures/pdf_VleesLuxe.pdf', label: 'Vleespakket luxe', note: 'Negen soorten vlees en vis' },
  { href: '/brochures/pdf_VleesBasis.pdf', label: 'Vleespakket basis', note: 'Vijf soorten vlees voor de barbecue' },
  { href: '/brochures/pdf_Borrelplanken.pdf', label: 'Borrelplanken', note: 'Van grillworst en kaas tot paling en olijven' },
  { href: '/brochures/pdf_Broodjes.pdf', label: 'Broodjeslunch', note: 'Met brood van Bakkerij van Harberden' },
  { href: '/brochures/pdf_Vergaderen.pdf', label: 'Vergaderen', note: 'Ruimte, arrangementen en buffetten' },
  { href: '/brochures/pdf_Koffie.pdf', label: 'Koffie', note: 'Volautomaat huren met bonen van Roger’s Coffee' },
];
---

<BaseLayout
  title="Catering op locatie — BBQ, buffetten en hapjes van Wesley’s Ambacht"
  description="Ambachtelijke catering in Stellendam en omgeving: BBQ op locatie, buffetten, walking diner, hapjes, borrelplanken en broodjeslunch. Zonder E-nummers, met verse kruiden uit de eigen tuin."
  ogImage="/images/linkkaart.png"
>
  <Hero
    eyebrow="Catering"
    titel="Wij komen naar je toe"
    lead="BBQ, buffetten, walking diner, hapjes en broodjes. Met een chef die weet wanneer het vlees klaar is, met producten uit onze eigen keuken en zonder E-nummers."
    foto="/images/Wesley-BBQ-op-locatie.jpeg"
    fotoAlt="Wesley bij de barbecue op locatie, met de kofferwagen van Wesley’s Ambacht."
    fotoPositie="45% 55%"
    gloed={true}
    acties={[
      { label: 'Offerte aanvragen', href: '/contact' },
      { label: 'Brochures downloaden', href: '#brochures', variant: 'outline' },
    ]}
  />

  <section class="sectie">
    <div class="rail">
      <SectieKop
        eyebrow="Wat we doen"
        title="Van hapje tot buffet"
        lead="Elke gelegenheid heeft een eigen aanpak. Hieronder wat wij doen en wat erbij hoort."
      />

      <div class="diensten">
        {
          catering.map((dienst) => (
            <article class="dienst">
              <h3>{dienst.titel}</h3>
              <p>{dienst.tekst}</p>
              <ul>
                {dienst.punten.map((punt) => (
                  <li>{punt}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ EEN AVOND BBQ ============ -->
  <section class="sectie sectie-schuim">
    <div class="rail">
      <SectieKop
        eyebrow="Hoe een avond verloopt"
        title="Zo gaat een barbecue-avond"
        lead="Van opzetten tot het laatste bord. Jij hebt een avond, wij hebben het vuur."
      />

      <ol class="avond">
        {
          grillAvond.map((stap) => (
            <li class="avond-stap">
              <span class="avond-moment">{stap.moment}</span>
              <p>{stap.tekst}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <HavenBand
    afbeelding="/images/barbecueplank.jpg"
    alt="Een barbecueplank met gegrilld vlees, worsten, loaded fries en saus."
    zin="Wesley kiest het vuur. Jij kiest wat erop komt."
    onderschrift="Vleespakketten, buffetten en hapjes, allemaal met producten uit de eigen keuken."
  />

  <section class="sectie sectie-schuim">
    <div class="rail">
      <SectieKop
        eyebrow="Voor de barbecue"
        title="Vleespakketten"
        lead="Beide pakketten zijn per persoon. Je kiest zelf hoeveel personen, wij zorgen voor het vuur en het vlees."
      />
      <div class="brochure-knoppen">
        {
          vleespakketten.map((pakket) =>
            pakket.brochure ? (
              <a href={pakket.brochure.href} class="tekst-link brochure-link">
                {pakket.brochure.label}
              </a>
            ) : null
          )
        }
      </div>
    </div>
  </section>

  <section class="sectie rooster" id="vleespakketten">
    <div class="rail">
      <SectieKop
        eyebrow="Vuur en vlees"
        title="Wat er op het rooster ligt"
        lead="Wesley stuurt het vuur aan. De worsten gaan er als eerste op, het vlees volgt zodra het vuur op temperatuur is. Je kiest zelf wat erop komt."
      />

      <div class="vleespakketten">
        {
          vleespakketten.map((pakket) => (
            <article class="vleespakket">
              <span class="vleespakket-label">
                {pakket.naam === 'Vleespakket luxe' ? 'Uitgebreid' : 'De basis'}
              </span>
              <h3>{pakket.naam}</h3>
              <p class="vleespakket-prijs">{pakket.prijs}</p>
              <p class="vleespakket-tekst">{pakket.omschrijving}</p>
              <ul class="vleespakket-lijst">
                {pakket.details?.map((detail) => <li>{detail}</li>)}
              </ul>
            </article>
          ))
        }
      </div>

      <a href="/catering#brochures" class="tekst-link kaart-link">Alle arrangementen en prijzen</a>
    </div>
  </section>

  <section class="sectie">
    <div class="rail">
      <SectieKop
        eyebrow="Voor grotere groepen"
        title="Buffetten en arrangementen"
        lead="Buffetten zijn er vanaf tien personen. Warm buffet naar keuze, BBQ buffet in twee niveaus en stamppotbuffetten met of zonder soep."
      />
      <div class="buffet-grid">
        <div class="">
          <Menukaart
            titel="Buffetten"
            ondertitel="Vanaf tien personen, prijs per persoon"
            rows={buffetten}
          />
        </div>
        <figure class="buffet-foto">
          <img
            src="/images/ambachtelijke-buffetten.jpeg"
            alt="Een buffet met worsten, kaas, salades, groenten en hapjes op houten borden."
            width="1600"
            height="1200"
            loading="lazy"
            decoding="async"
          />
          <figcaption>Ambachtelijke buffetten, klaargezet in eigen keuken.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="sectie sectie-schuim">
    <div class="rail">
      <SectieKop
        eyebrow="Kleinere groepen"
        title="Salades, borrelplanken, broodjes en koffie"
        lead="Voor een lunch, een borrel of een feest waar de vuurplaats te groot voor is."
      />

      <div class="kleine-producten">
        <div class="">
          <h3 class="sub-kop">Ambachtelijke salades</h3>
          <p class="sub-tekst">Per persoon, te bestellen vanaf vijf personen.</p>
          <Menukaart zonderKop rows={salades} />
        </div>

        <div class="">
          <h3 class="sub-kop">Borrelplanken</h3>
          <p class="sub-tekst">Vanaf tien personen, graag een dag van tevoren bestellen.</p>
          <Menukaart zonderKop rows={borrelplanken} />
        </div>
      </div>

      <div class="twee-blokken">
        <article class="kaart">
          <h3 class="sub-kop">{broodjes.naam}</h3>
          <p>{broodjes.omschrijving}</p>
          <ul class="detail-lijst">
            {broodjes.details?.map((detail) => <li>{detail}</li>)}
          </ul>
          {
            broodjes.brochure && (
              <a href={broodjes.brochure.href} class="tekst-link brochure-link">
                {broodjes.brochure.label}
              </a>
            )
          }
        </article>

        <article class="kaart">
          <h3 class="sub-kop">{koffie.naam}</h3>
          <p class="prijs-regel">{koffie.prijs}</p>
          <p>{koffie.omschrijving}</p>
          <ul class="detail-lijst">
            {koffie.details?.map((detail) => <li>{detail}</li>)}
          </ul>
          {
            koffie.brochure && (
              <a href={koffie.brochure.href} class="tekst-link brochure-link">
                {koffie.brochure.label}
              </a>
            )
          }
        </article>
      </div>
    </div>
  </section>

  <section class="sectie" id="kosten">
    <div class="rail kosten-grid">
      <div class="">
        <SectieKop
          eyebrow="Praktisch"
          title="Wat er wel en niet bij zit"
          lead="Buffetten zijn exclusief bestek, borden en buffettafels. Die rekenen wij apart af, zodat je weet waar je aan begint."
        />
        <dl class="kosten-lijst">
          <div>
            <dt>Kok of medewerker bediening</dt>
            <dd>{kosten.kokPerUur}</dd>
          </div>
          <div>
            <dt>Ophalen van het materiaal</dt>
            <dd>{kosten.schoonmaak}</dd>
          </div>
          <div>
            <dt>Borden</dt>
            <dd>{kosten.borden}</dd>
          </div>
          <div>
            <dt>Bestek</dt>
            <dd>{kosten.bestek}</dd>
          </div>
          <div>
            <dt>Buffettafels</dt>
            <dd>{kosten.buffettafel}</dd>
          </div>
        </dl>
        <p class="kosten-noot">
          Prijzen zijn inclusief btw. Op maat maken wij een offerte.
        </p>
      </div>

      <div class="">
        <h3 class="sub-kop">Brochures</h3>
        <p class="sub-tekst">Alles op een rij, inclusief de volledige samenstellingen.</p>
        <ul class="brochure-lijst">
          {
            brochures.map((brochure) => (
              <li>
                <a href={brochure.href} class="brochure-item">
                  <span>
                    <span class="brochure-label">{brochure.label}</span>
                    <span class="brochure-noot">{brochure.note}</span>
                  </span>
                  <span class="brochure-pijl" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <path
                        d="M3 8h10M9 4l4 4-4 4"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="sectie sectie-schuim" id="brochures">
    <div class="rail">
      <SectieKop eyebrow="Veelgestelde vragen" title="Wat klanten ons vragen" />
      <div class="faq-wrap">
        <Faq />
      </div>
    </div>
  </section>

  <CtaBlok
    title="Vertel ons wat je viert"
    text="Aantal personen, datum en wat je in gedachten hebt. Wij maken een offerte met een vaste prijs en zorgen voor het vuur."
    primaryLabel="Offerte aanvragen"
    primaryHref="/contact"
    secondaryLabel={`Bel ${site.phone}`}
    secondaryHref={`tel:${site.phoneHref}`}
  />
</BaseLayout>

<style>
  .diensten {
    display: grid;
    gap: 1.25rem;
    margin-top: 3rem;
  }

  /* ---- EEN AVOND BBQ ---- */
  .avond {
    display: grid;
    gap: 1.5rem;
    margin-top: 3rem;
    list-style: none;
    padding: 0;
  }

  .avond-stap {
    position: relative;
    padding-left: 1.5rem;
    border-left: 2px solid var(--color-lijn);
  }

  .avond-moment {
    display: block;
    font-weight: 700;
    color: var(--color-haven);
    font-size: 1.0625rem;
  }

  .avond-stap p {
    margin-top: 0.375rem;
    font-size: 0.9375rem;
    color: var(--color-ink-mist);
    max-width: 32rem;
  }

  /* De eerste stap is het moment dat het vuur aangaat: die krijgt
     de kleur van het signaal. */
  .avond-stap:nth-child(2) {
    border-left-color: var(--color-signaal);
  }

  .avond-stap:nth-child(2) .avond-moment {
    color: var(--color-signaal);
  }

  @media (min-width: 900px) {
    .avond {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }

    .avond-stap {
      padding-left: 0;
      padding-top: 1.125rem;
      border-left: 0;
      border-top: 2px solid var(--color-lijn);
    }

    .avond-stap:nth-child(2) {
      border-top-color: var(--color-signaal);
    }
  }

  .dienst {
    padding: 1.75rem;
    background-color: var(--color-wit);
    border: 1px solid var(--color-lijn);
    border-radius: var(--radius-kaart);
  }

  .dienst h3 {
    font-size: 1.25rem;
  }

  .dienst > p {
    margin-top: 0.625rem;
    color: var(--color-ink-mist);
    font-size: 0.9375rem;
  }

  .dienst ul {
    list-style: none;
    padding: 0;
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .dienst li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 0.875rem;
    color: var(--color-ink-mist);
  }

  .dienst li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.625rem;
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background-color: var(--color-signaal);
  }

  @media (min-width: 700px) {
    .diensten {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1100px) {
    .diensten {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .prijzen-grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .brochure-knoppen {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .brochure-link {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 600;
  }

  /* ---- VLEESPAKKETTEN OP HET ROOSTER ---- */
  .vleespakketten {
    display: grid;
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .vleespakket {
    padding: 2rem;
    background-color: var(--color-wit);
    border: 1px solid var(--color-lijn);
    border-radius: var(--radius-kaart);
  }

  .vleespakket-label {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-signaal);
  }

  .vleespakket h3 {
    font-size: 1.375rem;
    margin-top: 0.625rem;
  }

  .vleespakket-prijs {
    margin-top: 0.25rem;
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-signaal);
    font-variant-numeric: tabular-nums;
  }

  .vleespakket-tekst {
    margin-top: 0.625rem;
    font-size: 0.9375rem;
    color: var(--color-ink-mist);
  }

  .vleespakket-lijst {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4375rem;
    margin-top: 1.25rem;
    list-style: none;
    padding: 0;
  }

  .vleespakket-lijst li {
    font-size: 0.8125rem;
    color: var(--color-haven);
    background-color: var(--color-schuim);
    border: 1px solid var(--color-lijn);
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
  }

  @media (min-width: 900px) {
    .vleespakketten {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  /* ---- BROCHURE-KNOPPEN ---- */

  @media (min-width: 900px) {
    .prijzen-grid {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 4rem;
    }
  }

  .buffet-grid {
    display: grid;
    gap: 2.5rem;
    margin-top: 3rem;
    align-items: start;
  }

  .buffet-foto {
    margin: 0;
    border-radius: var(--radius-kaart);
    overflow: hidden;
  }

  .buffet-foto img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-kaart);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 620ms var(--easing);
  }

  .buffet-foto:hover img {
    transform: scale(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .buffet-foto img {
      transition: none;
    }
  }

  .buffet-foto figcaption {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--color-ink-mist);
  }

  @media (min-width: 1000px) {
    .buffet-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 4rem;
    }
  }

  .kleine-producten {
    display: grid;
    gap: 3rem;
    margin-top: 3rem;
  }

  .sub-kop {
    font-size: 1.25rem;
  }

  .sub-tekst {
    margin-top: 0.375rem;
    margin-bottom: 1.5rem;
    color: var(--color-ink-mist);
    font-size: 0.9375rem;
  }

  @media (min-width: 900px) {
    .kleine-producten {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  .twee-blokken {
    display: grid;
    gap: 1.5rem;
    margin-top: 3.5rem;
  }

  .twee-blokken p {
    margin-top: 0.75rem;
    color: var(--color-ink-mist);
    font-size: 0.9375rem;
  }

  .prijs-regel {
    color: var(--color-signaal) !important;
    font-weight: 700;
    font-size: 1.125rem !important;
  }

  .detail-lijst {
    list-style: none;
    padding: 0;
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .detail-lijst li {
    font-size: 0.8125rem;
    color: var(--color-ink-mist);
    background-color: var(--color-schuim);
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
  }

  .twee-blokken .brochure-link {
    margin-top: 1.5rem;
  }

  @media (min-width: 700px) {
    .twee-blokken {
      grid-template-columns: 1fr 1fr;
    }
  }

  .kosten-grid {
    display: grid;
    gap: 3rem;
    align-items: start;
  }

  .kosten-lijst {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 2.5rem 0 0;
    min-width: 0;
  }

  .kosten-lijst > div {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--color-lijn);
  }

  .kosten-lijst dt {
    color: var(--color-ink-mist);
    font-size: 0.9375rem;
    min-width: 0;
  }

  .kosten-lijst dd {
    margin: 0;
    color: var(--color-ink);
    font-weight: 600;
    font-size: 0.9375rem;
    text-align: right;
    white-space: nowrap;
  }

  .kosten-noot {
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    color: var(--color-ink-mist);
  }

  .brochure-lijst {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .brochure-lijst li {
    border-bottom: 1px solid var(--color-lijn);
  }

  .brochure-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    text-decoration: none;
    color: var(--color-ink);
    transition: color var(--duur) var(--easing);
  }

  .brochure-item:hover {
    color: var(--color-signaal);
  }

  .brochure-label {
    display: block;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .brochure-noot {
    display: block;
    color: var(--color-ink-mist);
    font-size: 0.8125rem;
    margin-top: 0.125rem;
  }

  .brochure-pijl {
    color: var(--color-signaal);
    flex-shrink: 0;
  }

  .faq-wrap {
    margin-top: 2.5rem;
    max-width: 44rem;
  }
</style>
