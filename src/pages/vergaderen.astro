---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectieKop from '../components/SectieKop.astro';
import CtaBlok from '../components/CtaBlok.astro';
import Menukaart from '../components/Menukaart.astro';
import HavenBand from '../components/HavenBand.astro';
import { vergaderArrangementen, site, havenRondje } from '../data/site';
import { withBase } from '../lib/urls';
---

<BaseLayout
  title="Vergaderen met uitzicht — Stellendam aan de buitenhaven"
  description="Vergaderruimte met uitzicht over de buitenhaven van Stellendam. 120 per dagdeel, met koffie, lunch en borrel uit de keuken van Wesley’s Ambacht."
  ogImage="/images/linkkaart.png"
>
  <Hero
    eyebrow="Vergaderen"
    titel="Vergaderen met uitzicht"
    lead="Een sfeervolle ruimte over de buitenhaven van Stellendam. Zonder twijfel het mooiste uitzicht dat de stad te bieden heeft, met koffie, lunch en borrel uit onze eigen keuken."
    foto="/images/havenpaviljoen.jpg"
    fotoAlt="Het terras van de Ambachtswinkel aan de buitenhaven van Stellendam bij zonsondergang, met tafels en parasollen."
    fotoPositie="50% 55%"
    acties={[
      { label: 'Ruimte aanvragen', href: '/contact' },
      { label: 'Brochure vergaderen', href: '/brochures/pdf_Vergaderen.pdf', variant: 'outline' },
    ]}
  />

  <section class="sectie">
    <div class="rail ruimte-grid">
      <div class="">
        <SectieKop
          eyebrow="De ruimte"
          title="Productiviteit met een raam erbij"
          lead="Een korte meeting of een lange sessie: je zit in een ontspannen omgeving met de haven voor je neus. De ruimte is standaard ingericht, zodat jij je kunt richten op de inhoud."
        />

        <ul class="eigenschappen">
          <li>
            <h3>Uniek uitzicht</h3>
            <p>Over de buitenhaven, met de havenvloot en de zonsondergang ervoor.</p>
          </li>
          <li>
            <h3>Volledig ingericht</h3>
            <p>Flipover, whiteboard en tafel. Een beamer huur je op aanvraag.</p>
          </li>
          <li>
            <h3>Ambachtelijke catering</h3>
            <p>Van koffie-arrangement tot luxe lunchbuffet en borrelplank, uit eigen keuken.</p>
          </li>
        </ul>
      </div>

      <figure class="ruimte-foto">
        <img
          src={withBase('/images/zonsondergang-havenkroeg.jpg')}
          alt="Het havenplein van Stellendam bij zonsondergang, met terrassen en de havenkroeg."
          width="1415"
          height="1111"
          loading="lazy"
          decoding="async"
        />
        <figcaption>De buitenhaven, van waaruit je de ruimte ziet.</figcaption>
      </figure>
    </div>
  </section>

  <section class="sectie sectie-schuim" id="arrangementen">
    <div class="rail">
      <SectieKop
        eyebrow="Arrangementen"
        title="Alles op één rij"
        lead="De huur van de ruimte is 120 per dagdeel. Koffie, lunch en borrel kunnen we erbij verzorgen."
      />
      <div class="arrangementen">
        <Menukaart
          titel="Arrangementen"
          ondertitel="Prijs per persoon of per dagdeel"
          rows={vergaderArrangementen.map((item) => ({
            naam: item.naam,
            prijs: item.prijs,
            omschrijving: item.omschrijving,
          }))}
        />
      </div>
    </div>
  </section>

  <HavenBand
    afbeelding="/images/zonsondergang-zee.jpg"
    alt="De zon die ondergaat boven de zee, met het licht op het water."
    zin="Een raam op de zee, en een tafel die daar op uitkomt."
    onderschrift="Vergaderen, lunchen of borrelen met de haven voor je neus."
  />

  <section class="sectie">
    <div class="rail">
      <SectieKop
        eyebrow="Om de hoek"
        title="Tijdens de pauze"
        lead="De koffie staat klaar. De rest ligt op loopafstand: de haven, de kust en het dorp."
      />

      <ul class="rondje">
        {
          havenRondje.map((plek) => (
            <li>
              <h3>{plek.plaats}</h3>
              <p>{plek.wat}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBlok
    title="Een datum vastleggen?"
    text="Vertel ons wanneer je wilt vergaderen en hoeveel mensen er komen. Wij zorgen voor de ruimte, de koffie en de lunch."
    primaryLabel="Ruimte aanvragen"
    primaryHref="/contact"
    secondaryLabel={`Bel ${site.phone}`}
    secondaryHref={`tel:${site.phoneHref}`}
  />
</BaseLayout>

<style>
  .ruimte-grid {
    display: grid;
    gap: 3rem;
    align-items: start;
  }

  .eigenschappen {
    display: grid;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .eigenschappen h3 {
    font-size: 1.125rem;
  }

  .eigenschappen p {
    margin-top: 0.375rem;
    color: var(--color-ink-mist);
    font-size: 0.9375rem;
  }

  .ruimte-foto {
    margin: 0;
  }

  .ruimte-foto img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-kaart);
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .ruimte-foto figcaption {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--color-ink-mist);
  }

  @media (min-width: 900px) {
    .ruimte-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 4rem;
    }

    .eigenschappen {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  .arrangementen {
    margin-top: 2.5rem;
    max-width: 46rem;
  }

  .rondje {
    display: grid;
    gap: 1.5rem;
    margin-top: 3rem;
    list-style: none;
    padding: 0;
  }

  .rondje li {
    position: relative;
    padding-left: 1.25rem;
    border-left: 2px solid var(--color-signaal);
  }

  .rondje h3 {
    font-size: 1.0625rem;
  }

  .rondje p {
    margin-top: 0.375rem;
    font-size: 0.9375rem;
    color: var(--color-ink-mist);
  }

  @media (min-width: 800px) {
    .rondje {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }
  }
</style>
