---
import '../styles/global.css';
import StickyHeader from '../components/StickyHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SluitingBanner from '../components/SluitingBanner.astro';
import MobielActieBalk from '../components/MobielActieBalk.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Wesley's Ambacht — Verse vis, ambachtelijke catering en vergaderen in Stellendam",
  description = 'Verse vis direct van de vismijn in Stellendam, ambachtelijke catering op locatie en een vergaderruimte met uitzicht over de buitenhaven. Zonder E-nummers, met verse kruiden uit de eigen tuin.',
  ogImage = '/images/linkkaart.png',
} = Astro.props;

const siteUrl = 'https://ambachtbijwesley.nl';
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).href} />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:site_name" content="Wesley's Ambacht" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl).href} />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      name: "Wesley's Ambacht",
      description,
      telephone: '+31639581128',
      email: 'info@ambachtswinkel.nl',
      url: siteUrl,
      image: new URL(ogImage, siteUrl).href,
      priceRange: '€€',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Meester Snijderweg 5',
        postalCode: '3251 LJ',
        addressLocality: 'Stellendam',
        addressCountry: 'NL',
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday'],
          opens: '10:00',
          closes: '18:00',
        },
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Saturday'],
          opens: '10:00',
          closes: '18:00',
        },
      ],
      sameAs: [
        'https://www.instagram.com/ambachtswinkel/',
        'https://www.facebook.com/people/De-Ambachtswinkel/100090758690891/',
      ],
    })} />
  </head>

  <body>
    <a href="#inhoud" class="skip-link">Naar de inhoud</a>
    <SluitingBanner />
    <StickyHeader />
    <main id="inhoud">
      <slot />
    </main>
    <SiteFooter />
    <MobielActieBalk />

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: var(--color-signaal);
    color: var(--color-wit);
    padding: 0.75rem 1.25rem;
    font-weight: 600;
    border-radius: 0 0 var(--radius-invoer) 0;
  }

  .skip-link:focus {
    left: 0;
  }
</style>
